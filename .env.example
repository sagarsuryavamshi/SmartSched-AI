# ==============================================================================
# SmartSched AI — Production Environment Variables Configuration Template
# COPY TO .env IN PRODUCTION AND REPLACE ALL PLACEHOLDERS WITH REAL SECRETS
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="SmartSched AI API"
VERSION="1.0.0"

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_64_char_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connectivity (PostgreSQL 16+ on Render / Neon / AWS RDS)
DATABASE_URL=postgresql://smartsched_user:replace_with_db_password@your-postgres-host.render.com:5432/smartsched_db

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
CORS_ORIGINS=https://smartsched-ai.vercel.app,https://your-custom-domain.edu,http://localhost:3000

# Next.js Frontend Configuration (Used when building/deploying frontend)
NEXT_PUBLIC_API_URL=https://smartsched-backend.onrender.com/api/v1
